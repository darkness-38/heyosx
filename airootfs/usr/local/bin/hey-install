#!/usr/bin/env bash
# =============================================================================
# hey-install — heyOS CLI Installer (ULTRA OPTIMIZED)
# =============================================================================

set -euo pipefail
export LC_ALL=C

# ---- Color codes ----
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; PINK='\033[1;35m'; BOLD='\033[1m'; NC='\033[0m'

# ---- Configuration ----
MOUNT_POINT="/mnt"
LOG_FILE="/var/log/hey-install.log"
SELECTED_TIMEZONE="UTC"
SELECTED_LOCALE="en_US.UTF-8"
SELECTED_KEYMAP="us"
OFFLINE_REPO="/opt/heyos-packages"
VERBOSE=false

# ---- Parse flags ----
for arg in "$@"; do
    case "$arg" in
        -v|--verbose) VERBOSE=true ;;
    esac
done

# =============================================================================
# Utility Functions
# =============================================================================

log_info()  { echo -e "${BLUE}[INFO]${NC}  $*" | tee -a "$LOG_FILE"; }
log_ok()    { echo -e "${GREEN}[OK]${NC}    $*" | tee -a "$LOG_FILE"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC}  $*" | tee -a "$LOG_FILE"; }
log_err()   { echo -e "${RED}[ERROR]${NC} $*" | tee -a "$LOG_FILE"; }
log_step()  { echo -e "\n${PINK}${BOLD}==> $*${NC}" | tee -a "$LOG_FILE"; }

run_verbose() {
    if $VERBOSE; then "$@" 2>&1 | tee -a "$LOG_FILE"; else "$@" &>> "$LOG_FILE"; fi
}

display_grid() {
    local items=("$@")
    local term_width=$(tput cols 2>/dev/null || echo 80)
    local max_len=0
    for item in "${items[@]}"; do [[ ${#item} -gt $max_len ]] && max_len=${#item}; done
    local col_width=$((max_len + 2))
    local cols=$((term_width / col_width))
    [[ $cols -lt 1 ]] && cols=1
    local count=0
    for item in "${items[@]}"; do
        printf "%-${col_width}s" "$item"
        ((count+=1))
        [[ $((count % cols)) -eq 0 ]] && echo ""
    done
    echo ""
}

fuzzy_match() {
    local input="$1"; shift; local items=("$@")
    for i in "${items[@]}"; do [[ "$i" == "$input" ]] && { echo "$i"; return 0; }; done
    for i in "${items[@]}"; do [[ "${i,,}" == "${input,,}" ]] && { echo "$i"; return 0; }; done
    for i in "${items[@]}"; do [[ "${i,,}" == "${input,,}"* ]] && { echo "$i"; return 0; }; done
    for i in "${items[@]}"; do [[ "${i,,}" == *"${input,,}"* ]] && { echo "$i"; return 0; }; done
    return 1
}

confirm() {
    local prompt="${1:-Continue?}"
    echo -en "${YELLOW}${prompt} [y/N]: ${NC}"
    read -r response
    [[ "$response" =~ ^[Yy]$ ]]
}

show_banner() {
    echo -e "${PINK}"
    cat << 'EOF'
    ██╗  ██╗███████╗██╗   ██╗ ██████╗ ███████╗
    ██║  ██║██╔════╝╚██╗ ██╔╝██╔═══██╗██╔════╝
    ███████║█████╗   ╚████╔╝ ██║   ██║███████╗
    ██╔══██║██╔══╝    ╚██╔╝  ██║   ██║╚════██║
    ██║  ██║███████╗   ██║   ╚██████╔╝███████║
    ╚═╝  ╚═╝╚══════╝   ╚═╝    ╚═════╝ ╚══════╝
            ═══ heyOS Installer ═══
EOF
    echo -e "${NC}"
}

# =============================================================================
# Step 1: Pre-flight & Fast Metadata Gathering
# =============================================================================

preflight_checks() {
    log_step "Step 1: Pre-flight Checks"
    [[ $EUID -ne 0 ]] && { log_err "Must be run as root."; exit 1; }

    BOOT_MODE="uefi"
    [[ ! -d /sys/firmware/efi ]] && BOOT_MODE="bios"
    log_ok "Boot mode: $BOOT_MODE"

    timedatectl set-ntp true 2>/dev/null || true
    
    IS_OFFLINE=true
    if ping -c 1 -W 1 1.1.1.1 &>/dev/null; then
        IS_OFFLINE=false
        log_ok "Network detected."
    else
        log_warn "Offline mode enabled (No internet)."
    fi
}

# =============================================================================
# Step 2: Batch Interaction (Get all input upfront)
# =============================================================================

get_user_input() {
    log_step "Step 2: Configuration"

    # 1. Disk Selection
    echo -e "\n${BOLD}Target Disk:${NC}"
    lsblk -dpno NAME,SIZE,MODEL | grep -v "^/dev/loop\|^/dev/sr\|^/dev/ram" || true
    while true; do
        echo -en "${BOLD}Disk (e.g. /dev/nvme0n1): ${NC}"
        read -r TARGET_DISK
        [[ -b "$TARGET_DISK" ]] && break
    done

    # 2. Filesystem
    echo -en "\n${BOLD}Filesystem (1: ext4, 2: btrfs) [2]: ${NC}"
    read -r fs_choice
    ROOT_FS="btrfs"; [[ "$fs_choice" == "1" ]] && ROOT_FS="ext4"

    # 3. Localization (Fast Defaults)
    echo -en "\n${BOLD}Timezone [${SELECTED_TIMEZONE}]: ${NC}"
    read -r tz_input
    [[ -n "$tz_input" && -f "/usr/share/zoneinfo/$tz_input" ]] && SELECTED_TIMEZONE="$tz_input"

    echo -en "${BOLD}Locale [${SELECTED_LOCALE}]: ${NC}"
    read -r loc_input
    [[ -n "$loc_input" ]] && SELECTED_LOCALE="$loc_input"

    # 4. Keyboard Layout
    echo -en "${BOLD}Keyboard Layout [${SELECTED_KEYMAP}]: ${NC}"
    read -r key_input
    [[ -n "$key_input" ]] && SELECTED_KEYMAP="$key_input"

    # 5. User Account
    echo -en "\n${BOLD}New Username: ${NC}"
    read -r NEW_USER
    while true; do
        echo -en "${BOLD}User Password: ${NC}"
        read -rs USER_PASS; echo ""
        echo -en "${BOLD}Confirm Password: ${NC}"
        read -rs USER_PASS_CONF; echo ""
        [[ "$USER_PASS" == "$USER_PASS_CONF" ]] && break
        log_err "Passwords do not match."
    done

    while true; do
        echo -en "${BOLD}Root Password: ${NC}"
        read -rs ROOT_PASS; echo ""
        echo -en "${BOLD}Confirm Root Password: ${NC}"
        read -rs ROOT_PASS_CONF; echo ""
        [[ "$ROOT_PASS" == "$ROOT_PASS_CONF" ]] && break
        log_err "Passwords do not match."
    done

    echo -e "\n${RED}${BOLD}FINAL WARNING: Data on $TARGET_DISK will be WIPED!${NC}"
    confirm "Proceed with installation?" || exit 1
}

# =============================================================================
# Step 3: Fast Disk Ops
# =============================================================================

apply_disk_ops() {
    log_step "Step 3: Disk Preparation"
    
    run_verbose wipefs -af "$TARGET_DISK"
    run_verbose sgdisk --zap-all "$TARGET_DISK"

    if [[ "$BOOT_MODE" == "uefi" ]]; then
        run_verbose sgdisk -n 1:0:+512M -t 1:EF00 -c 1:"EFI" "$TARGET_DISK"
        run_verbose sgdisk -n 2:0:0     -t 2:8300 -c 2:"Root" "$TARGET_DISK"
        partprobe "$TARGET_DISK" && udevadm settle
        EFI_PART=$(lsblk -rnpo NAME,PARTN "$TARGET_DISK" | awk '$2=="1" {print $1}')
        ROOT_PART=$(lsblk -rnpo NAME,PARTN "$TARGET_DISK" | awk '$2=="2" {print $1}')
        run_verbose mkfs.fat -F32 "$EFI_PART"
    else
        echo -e "o\nn\np\n1\n\n\nw" | fdisk "$TARGET_DISK" &>/dev/null
        partprobe "$TARGET_DISK" && udevadm settle
        ROOT_PART=$(lsblk -rnpo NAME,PARTN "$TARGET_DISK" | awk '$2=="1" {print $1}')
        EFI_PART=""
    fi

    case "$ROOT_FS" in
        ext4)  run_verbose mkfs.ext4 -F -L "heyOS" "$ROOT_PART" ;;
        btrfs) run_verbose mkfs.btrfs -f -L "heyOS" "$ROOT_PART" ;;
    esac
}

mount_filesystems() {
    log_step "Step 4: Mounting"
    local BTRFS_OPTS="noatime,compress=zstd,space_cache=v2,discard=async,ssd"

    if [[ "$ROOT_FS" == "btrfs" ]]; then
        mount "$ROOT_PART" "$MOUNT_POINT"
        btrfs subvolume create "$MOUNT_POINT/@" &>/dev/null
        btrfs subvolume create "$MOUNT_POINT/@home" &>/dev/null
        umount "$MOUNT_POINT"
        mount -o "$BTRFS_OPTS,subvol=@" "$ROOT_PART" "$MOUNT_POINT"
        mkdir -p "$MOUNT_POINT/home"
        mount -o "$BTRFS_OPTS,subvol=@home" "$ROOT_PART" "$MOUNT_POINT/home"
    else
        mount -o "noatime" "$ROOT_PART" "$MOUNT_POINT"
    fi

    if [[ -n "$EFI_PART" ]]; then
        mkdir -p "$MOUNT_POINT/boot/efi"
        mount "$EFI_PART" "$MOUNT_POINT/boot/efi"
    fi
}

# =============================================================================
# Step 5: High-Speed Installation
# =============================================================================

install_base() {
    log_step "Step 5: Installation"
    
    local target_pkg_file="/usr/share/heyos/packages.target"
    local pkgs=($(grep -v '^#' "$target_pkg_file" | xargs))
    
    log_info "Configuring offline-first pacman..."
    
    # Create a custom pacman.conf for pacstrap that PRIORITIZES the local repo
    # We include [core] and [extra] only as fallback, but we make them optional
    # to avoid errors if the mirrorlist is empty or network is down.
    cat << EOF > /tmp/offline-pacman.conf
[options]
HoldPkg     = pacman glibc
Architecture = auto
ParallelDownloads = 10
SigLevel    = Optional TrustAll
LocalFileSigLevel = Optional

[heyos_offline]
SigLevel = Optional TrustAll
Server = file://${OFFLINE_REPO}

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist
EOF

    # Fix: Ensure the mirrorlist exists and is not empty to avoid "no servers configured"
    # If it's empty, we comment out the core/extra repos to force 100% offline mode
    if [[ ! -s /etc/pacman.d/mirrorlist ]] || ! grep -q "^Server" /etc/pacman.d/mirrorlist; then
        log_warn "No active mirrors detected. Enabling strict offline mode."
        sed -i '/\[core\]/,$d' /tmp/offline-pacman.conf
    fi

    log_info "Deploying system packages from integrated ISO storage..."
    # Use -C to specify our offline-first config
    pacstrap -K -C /tmp/offline-pacman.conf "$MOUNT_POINT" "${pkgs[@]}" 2>&1 | tee -a "$LOG_FILE"
}

# =============================================================================
# Step 6: Atomic Configuration
# =============================================================================

configure_system() {
    log_step "Step 6: Configuration"
    
    genfstab -U "$MOUNT_POINT" >> "$MOUNT_POINT/etc/fstab"
    cp -r /etc/skel/. "$MOUNT_POINT/etc/skel/"
    cp /usr/bin/hey-greeter "$MOUNT_POINT/usr/bin/"
    cp /usr/local/bin/hey-greeter-launch "$MOUNT_POINT/usr/local/bin/"
    chmod 755 "$MOUNT_POINT/usr/bin/hey-greeter" "$MOUNT_POINT/usr/local/bin/hey-greeter-launch"

    # Chroot scripting (Atomic)
    cat << EOF | arch-chroot "$MOUNT_POINT"
set -e
ln -sf /usr/share/zoneinfo/${SELECTED_TIMEZONE} /etc/localtime
hwclock --systohc
echo "${SELECTED_LOCALE} UTF-8" >> /etc/locale.gen
locale-gen &>/dev/null
echo "LANG=${SELECTED_LOCALE}" > /etc/locale.conf
echo "KEYMAP=${SELECTED_KEYMAP}" > /etc/vconsole.conf
echo "heyOS" > /etc/hostname
systemctl enable NetworkManager seatd greetd &>/dev/null
systemctl set-default graphical.target &>/dev/null
useradd -m -G wheel,video,render,audio,input,seat -s /bin/bash "$NEW_USER"
echo "root:${ROOT_PASS}" | chpasswd
echo "${NEW_USER}:${USER_PASS}" | chpasswd
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/00-heyos
chmod 440 /etc/sudoers.d/00-heyos
mkinitcpio -P &>/dev/null
EOF

    # Bootloader
    log_info "Bootloader..."
    if [[ "$BOOT_MODE" == "uefi" ]]; then
        arch-chroot "$MOUNT_POINT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=heyOS --removable &>/dev/null
    else
        arch-chroot "$MOUNT_POINT" grub-install --target=i386-pc "$TARGET_DISK" &>/dev/null
    fi
    sed -i 's/^#GRUB_DISABLE_OS_PROBER=false/GRUB_DISABLE_OS_PROBER=false/' "$MOUNT_POINT/etc/default/grub"
    arch-chroot "$MOUNT_POINT" grub-mkconfig -o /boot/grub/grub.cfg &>/dev/null
}

cleanup() {
    log_step "Finalizing"
    umount -R "$MOUNT_POINT" &>/dev/null || true
    log_ok "heyOS Installed! Total time: $(( (SECONDS - BUILD_START) / 60 ))m $(( (SECONDS - BUILD_START) % 60 ))s"
}

# =============================================================================
# Main
# =============================================================================
BUILD_START=$SECONDS
show_banner
preflight_checks
get_user_input
apply_disk_ops
mount_filesystems
install_base
configure_system
cleanup
