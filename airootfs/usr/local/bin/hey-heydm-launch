#!/bin/sh
# hey-heydm-launch — Wrapper to start heydm under cage with safe rendering
# Forces software rendering so it works inside VMs.

export WLR_RENDERER=pixman
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1

# For heydm (Smithay/Glow) to use software GL if it doesn't have a pixman path
export GALLIUM_DRIVER=llvmpipe

exec cage -d -s -- /usr/bin/heydm
