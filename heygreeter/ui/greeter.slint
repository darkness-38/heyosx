import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "heyOS Greeter";
    no-frame: true;
    background: #111;
    default-font-family: "Noto Sans";

    callback login(string, string, string);

    in property <[string]> users: ["marvin", "hey"];
    in property <[string]> sessions: ["heydm", "sway"];
    in property <string> error-message: "";
    
    in property <string> current-time: "12:20 AM";
    in property <string> current-date: "Saturday, May 2, 2020";

    out property <string> selected-user: users[user-index];
    out property <string> selected-session: sessions[0];
    
    property <int> user-index: 0;
    property <bool> show-user-list: false;

    // ---- Living background (gentle color animation) ----
    Rectangle {
        width: 100%;
        height: 100%;
        
        property <color> color1: #a67c52;
        property <color> color2: #3a7a8a;
        
        background: @linear-gradient(135deg, color1 0%, #6a9ea8 40%, color2 70%, #1e4552 100%);
        
        animate color1, color2 { duration: 8000ms; easing: ease-in-out; iteration-count: -1; }
        
        // Initial state doesn't loop color change in Slint easily without a timer in Rust, 
        // but we can define states if we want it to shift.
        // For now, let's keep the gradient fixed but vibrant.
    }

    // ---- Main Centered Content ----
    VerticalLayout {
        alignment: center;
        padding-top: 60px;
        padding-bottom: 140px;

        // Clock
        Text {
            text: root.current-time;
            font-size: 72px;
            font-weight: 200;
            color: #ffffffdd;
            horizontal-alignment: center;
        }

        // Date
        Text {
            text: root.current-date;
            font-size: 22px;
            font-weight: 400;
            color: #ffffffcc;
            horizontal-alignment: center;
        }

        // Spacer
        Rectangle { height: 40px; }

        // Avatar circle
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 120px;
                height: 120px;
                border-radius: 60px;
                border-width: 2px;
                border-color: #ffffffaa;
                background: transparent;
                clip: true;

                // Head
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    border-width: 2px;
                    border-color: #ffffffaa;
                    background: transparent;
                    x: 40px;
                    y: 22px;
                }
                // Body
                Rectangle {
                    width: 80px;
                    height: 44px;
                    border-radius: 40px;
                    border-width: 2px;
                    border-color: #ffffffaa;
                    background: transparent;
                    x: 20px;
                    y: 72px;
                }
            }
        }

        // Spacer
        Rectangle { height: 10px; }

        // Username + dropdown trigger
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 200px;
                height: 36px;
                background: user-trigger-touch.has-hover ? #ffffff11 : transparent;
                border-radius: 4px;
                animate background { duration: 150ms; }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: root.selected-user;
                        font-size: 20px;
                        font-weight: 400;
                        color: white;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▾";
                        font-size: 16px;
                        color: #ffffffaa;
                        vertical-alignment: center;
                    }
                }

                user-trigger-touch := TouchArea {
                    clicked => { root.show-user-list = !root.show-user-list; }
                }
            }
        }

        // User dropdown popup
        if root.show-user-list : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 180px;
                height: 30px * root.users.length;
                background: #ffffffe8;
                border-radius: 4px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000044;

                VerticalLayout {
                    padding: 2px;
                    for user[i] in root.users : Rectangle {
                        height: 30px;
                        background: user-touch.has-hover ? #0078d7 : transparent;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 12px;
                            alignment: start;
                            Text {
                                text: user;
                                font-size: 14px;
                                color: user-touch.has-hover ? white : #333;
                                vertical-alignment: center;
                            }
                        }
                        user-touch := TouchArea {
                            clicked => {
                                root.user-index = i;
                                root.show-user-list = false;
                            }
                        }
                    }
                }
            }
        }

        // Spacer
        Rectangle { height: 16px; }

        // Password field + submit button
        HorizontalLayout {
            alignment: center;
            spacing: 0px;

            Rectangle {
                width: 260px;
                height: 36px;
                background: #ffffff22;
                border-width: 1px;
                border-color: pwd.has-focus ? #ffffffaa : #ffffff55;
                border-radius: 2px;
                animate border-color { duration: 200ms; }

                // Glow effect
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 2px;
                    border-width: pwd.has-focus ? 1.5px : 0px;
                    border-color: #ffffff44;
                    animate border-width { duration: 200ms; }
                }

                pwd := LineEdit {
                    width: 100%;
                    height: 100%;
                    placeholder-text: "Password";
                    input-type: password;
                    font-size: 14px;
                    accepted => { root.login(root.selected-user, self.text, root.selected-session); }
                }
            }

            Rectangle {
                width: 36px;
                height: 36px;
                
                // Scale effect via padding if we want to keep layout stable, 
                // but let's just animate the inner content or slightly adjust width/height
                // Actually, let's use a sub-rectangle for the actual button visual
                
                Rectangle {
                    width: touch.pressed ? 32px : 36px;
                    height: touch.pressed ? 32px : 36px;
                    animate width, height { duration: 100ms; easing: ease-in-out; }
                    
                    background: touch.pressed ? #ffffff44 : (touch.has-hover ? #ffffff33 : #ffffff22);
                    border-width: 1px;
                    border-color: touch.has-hover ? #ffffffaa : #ffffff55;
                    border-radius: 2px;
                    animate background, border-color { duration: 150ms; }

                    Text {
                        text: "›";
                        font-size: 24px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                touch := TouchArea {
                    clicked => { root.login(root.selected-user, pwd.text, root.selected-session); }
                }
            }
        }

        // Error message
        if root.error-message != "" : Text {
            text: root.error-message;
            color: #ff6b6b;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    // ---- Bottom Power Icons (centered) ----
    HorizontalLayout {
        y: parent.height - 100px;
        x: 0px;
        width: 100%;
        alignment: center;
        spacing: 60px;

        // Sleep
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            Text { 
                text: "☾"; 
                color: sleep-touch.has-hover ? #ffffff : #ffffffcc; 
                font-size: sleep-touch.has-hover ? 28px : 26px; 
                horizontal-alignment: center; 
                animate color, font-size { duration: 150ms; }
            }
            Text { 
                text: "Sleep"; 
                color: sleep-touch.has-hover ? #ffffff : #ffffffaa; 
                font-size: 12px; 
                horizontal-alignment: center; 
                animate color { duration: 150ms; }
            }
            sleep-touch := TouchArea {}
        }
        // Restart
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            Text { 
                text: "↻"; 
                color: restart-touch.has-hover ? #ffffff : #ffffffcc; 
                font-size: restart-touch.has-hover ? 28px : 26px; 
                horizontal-alignment: center; 
                animate color, font-size { duration: 150ms; }
            }
            Text { 
                text: "Restart"; 
                color: restart-touch.has-hover ? #ffffff : #ffffffaa; 
                font-size: 12px; 
                horizontal-alignment: center; 
                animate color { duration: 150ms; }
            }
            restart-touch := TouchArea {}
        }
        // Shut Down
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            Text { 
                text: "⏻"; 
                color: shutdown-touch.has-hover ? #ffffff : #ffffffcc; 
                font-size: shutdown-touch.has-hover ? 28px : 26px; 
                horizontal-alignment: center; 
                animate color, font-size { duration: 150ms; }
            }
            Text { 
                text: "Shut Down"; 
                color: shutdown-touch.has-hover ? #ffffff : #ffffffaa; 
                font-size: 12px; 
                horizontal-alignment: center; 
                animate color { duration: 150ms; }
            }
            shutdown-touch := TouchArea {}
        }
        // Other
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            Text { 
                text: "⌨"; 
                color: other-touch.has-hover ? #ffffff : #ffffffcc; 
                font-size: other-touch.has-hover ? 28px : 26px; 
                horizontal-alignment: center; 
                animate color, font-size { duration: 150ms; }
            }
            Text { 
                text: "Other..."; 
                color: other-touch.has-hover ? #ffffff : #ffffffaa; 
                font-size: 12px; 
                horizontal-alignment: center; 
                animate color { duration: 150ms; }
            }
            other-touch := TouchArea {}
        }
    }

    // ---- Bottom Right: Session Selector ----
    Rectangle {
        x: parent.width - self.width - 30px;
        y: parent.height - self.height - 30px;
        width: 160px;
        height: 56px;

        VerticalLayout {
            spacing: 4px;
            Text { text: "Session"; color: #ffffffaa; font-size: 12px; }
            ComboBox {
                height: 30px;
                model: root.sessions;
                current-value: root.selected-session;
                selected(val) => { root.selected-session = val; }
            }
        }
    }

    // ---- Bottom Left: Branding ----
    VerticalLayout {
        x: 30px;
        y: parent.height - self.height - 30px;
        width: 200px;
        height: 56px;
        alignment: end;

        Text {
            text: "heyOS Team";
            color: #ffffffaa;
            font-size: 14px;
            font-weight: 600;
        }
    }
}